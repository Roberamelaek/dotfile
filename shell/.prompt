# ─────────────────────────────────────────────────────────────
#  bash prompt — git branch, date/time, exit-code indicator
# ─────────────────────────────────────────────────────────────

set -o vi

parse_git_branch() {
    command -v git >/dev/null 2>&1 || return 0
    local branch
    branch="$(git rev-parse --abbrev-ref HEAD 2> /dev/null)" || return 0
    [[ -n "$branch" ]] && printf ' %s' "$branch"
}
